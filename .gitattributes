# 统一换行符，避免跨平台异常
#
# 默认：仓库内存 LF，检出时按平台自动处理
* text=auto eol=lf

# Shell 脚本必须是 LF —— CRLF 会让 Git Bash / WSL / Linux 报
# "bad interpreter: /usr/bin/env: no such file or directory"
*.sh text eol=lf

# Windows 专属脚本保持 CRLF（PowerShell 5.1 与 cmd 的传统习惯）
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.exe binary
